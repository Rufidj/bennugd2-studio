# Tileset: un tile por linea. El indice de cada tile es su posicion (1, 2, 3...). 0 = vacio.
# propiedades: textura= tapa= solido=0|1 dano=N resbala=0..1 rebota=N cinta=N (+derecha -izquierda)
#              unavia=1 mueve=x|y:bloques:velocidad forma=bloque|pinchos marcador=inicio|met|kaka|check
tile metal textura=metal.png tapa=metal_top.png solido=1
tile ladrillo textura=ladrillo.png solido=1
tile hielo textura=hielo.png solido=1 resbala=0.9
tile pinchos textura=pinchos.png solido=0 dano=3 forma=pinchos
tile trampolin textura=trampolin.png solido=1 rebota=30
tile cinta_der textura=cinta.png solido=1 cinta=5
tile cinta_izq textura=cinta.png solido=1 cinta=-5
tile plataforma_movil textura=plat.png solido=1 mueve=x:6:3
tile rejilla textura=una_via.png solido=1
tile inicio marcador=inicio
tile met marcador=met
tile kaka marcador=kaka
tile checkpoint marcador=check
tile agua textura=agua.png liquido=agua nado=1 lento=0.65 alfa=140
tile lava textura=lava.png liquido=lava dano=3 lento=0.45 alfa=235
tile acido textura=acido.png liquido=acido dano=2 lento=0.6 alfa=170
tile cieno textura=cieno.png liquido=cieno lento=0.3 alfa=215
tile rampa_der textura=metal.png rampa=der
tile rampa_izq textura=metal.png rampa=izq
tile ascensor textura=plat.png solido=1 mueve=y:6:2.5 activa=pisar
tile ascensor_auto textura=plat.png solido=1 mueve=y:5:2 espera=1.5
tile puerta textura=puerta.png solido=1 puerta=1
tile boton textura=boton.png boton=1
tile diana textura=diana.png solido=1 diana=1
tile puerta_azul textura=puerta_azul.png solido=1 puerta=2
tile boton_azul textura=boton_azul.png boton=2
tile diana_azul textura=diana_azul.png solido=1 diana=2
tile puerta_lado textura=puerta.png solido=1 puerta=1 abre=der
tile puerta_abajo textura=puerta_azul.png solido=1 puerta=2 abre=abajo
tile una_via textura=una_via.png solido=1 unavia=1
tile portal_fondo textura=portal_fondo.png portal=fondo
tile portal_frente textura=portal_frente.png portal=frente
tile portal_pasillo textura=portal_pasillo.png portal=pasillo
tile portal_exterior textura=portal_pasillo.png portal=exterior
# Decorado: se pintan en la capa 'Decorado' (columna de 'alto' bloques con la textura repetida). No tienen colision.
tile tronco textura=tronco.png solido=0 alto=5
tile hojas textura=hojas.png solido=0 alto=3
tile edificio textura=edificio.png solido=0 alto=10
tile roca textura=roca.png solido=0 alto=2
tile columna textura=columna.png solido=0 alto=6
# Puerta lateral a otra sala: portal=nivel:<escena de destino>. En 2D se entra con E / Arriba delante de ella; en un pasillo (capa Marcadores) con E cerca.
# Al llegar apareces en la puerta de la sala de destino que vuelve a donde estabas (ponla igual: otro tile con portal=nivel:<este nivel>).
tile puerta_sala textura=puerta_sala.png portal=nivel:sala
